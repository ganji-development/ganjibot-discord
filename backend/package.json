{
  "name": "@ganjibot/backend",
  "version": "0.1.0",
  "description": "Ganjibot Discord bot backend - core runtime, API, and addon manager",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "vite build",
    "start": "node dist/index.js",
    "start:sharded": "node dist/sharding.js",
    "dev:sharded": "tsx src/sharding.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:phase1": "vitest run tests/setup",
    "test:phase2": "vitest run tests/database",
    "test:phase3": "vitest run tests/bot",
    "test:phase4": "vitest run tests/audit",
    "test:phase5": "vitest run tests/addons",
    "test:phase6": "vitest run tests/api"
  },
  "keywords": [
    "discord",
    "bot",
    "modular",
    "addon",
    "typescript"
  ],
  "author": "Ganji Development",
  "license": "Apache-2.0",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@discordjs/rest": "^2.6.1",
    "@eslint/js": "^10.0.1",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "cors": "^2.8.6",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "globals": "^17.6.0",
    "graphql": "^16.14.0",
    "graphql-tag": "^2.12.6",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vite-plugin-static-copy": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}