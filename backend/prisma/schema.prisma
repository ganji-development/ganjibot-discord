generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// CORE MODELS
// =============================================================================

/// Access levels for dashboard permissions
enum AccessLevel {
  OWNER      /// Full control, can mass delete, grant owner to others
  ADMIN      /// Configure addons, settings, delete individual items
  MODERATOR  /// View + moderate content
  VIEWER     /// View-only access
}

/// Discord guild (server) registration
model Guild {
  id        String   @id /// Discord snowflake ID
  name      String   @db.VarChar(100)
  ownerId   String   @db.VarChar(64)
  iconHash  String?  @db.VarChar(64)
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  addons      GuildAddon[]
  auditLogs   AuditLog[]
  secrets     Secret[]
  accessGrants GuildAccess[]
  logConfig   LogConfig?

  @@map("guilds")
}

/// Dashboard access grants for users and roles
model GuildAccess {
  id        Int         @id @default(autoincrement())
  guildId   String      @db.VarChar(64)
  userId    String?     @db.VarChar(64)  /// Discord user ID (for direct grants)
  roleId    String?     @db.VarChar(64)  /// Discord role ID (for role-based grants)
  level     AccessLevel
  grantedBy String      @db.VarChar(64)  /// User who granted this access
  createdAt DateTime    @default(now())

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([guildId, roleId])
  @@map("guild_access")
}

/// Installed addons (metadata from NPM packages)
model Addon {
  id          String   @id /// NPM package name (e.g., @ganjibot/addon-tickets)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  version     String   @db.VarChar(32)
  author      String?  @db.VarChar(128)
  homepage    String?  @db.VarChar(256)
  manifest    Json     /// Addon manifest with permissions, commands, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  guilds  GuildAddon[]
  secrets Secret[]

  @@map("addons")
}

/// Per-guild addon installation and configuration
model GuildAddon {
  guildId   String
  addonId   String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  addon Addon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@id([guildId, addonId])
  @@map("guild_addons")
}

// =============================================================================
// AUDIT LOG
// =============================================================================

/// Audit log for bot actions and security events
model AuditLog {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(64)
  userId    String   @db.VarChar(64) /// User who triggered the action
  action    String   @db.VarChar(64) /// Action type (e.g., ADDON_INSTALLED, CONFIG_CHANGED)
  target    String?  @db.VarChar(256) /// Target of the action (e.g., addon ID, setting name)
  details   Json? /// Additional context
  ipAddress String?  @db.VarChar(45) /// IP for web dashboard actions
  createdAt DateTime @default(now())

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// =============================================================================
// AUTHENTICATION & SESSIONS
// =============================================================================

/// User sessions for dashboard authentication
model Session {
  id           String   @id @default(uuid())
  userId       String   @db.VarChar(64) /// Discord user ID
  accessToken  String   @db.Text /// Discord OAuth access token (encrypted)
  refreshToken String   @db.Text /// Discord OAuth refresh token (encrypted)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// =============================================================================
// SECRETS MANAGEMENT
// =============================================================================

/// Encrypted secrets for addons (API keys, tokens, etc.)
model Secret {
  id        Int      @id @default(autoincrement())
  guildId   String   @db.VarChar(64)
  addonId   String?  @db.VarChar(128) /// Null for core secrets
  key       String   @db.VarChar(128)
  value     String   @db.Text /// Encrypted value
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guild Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)
  addon Addon? @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([guildId, addonId, key])
  @@map("secrets")
}

// =============================================================================
// LOGGING CONFIGURATION
// =============================================================================

/// Configuration for utility logging (mod logs, server logs, etc.)
model LogConfig {
  id        Int      @id @default(autoincrement())
  guildId   String   @unique @db.VarChar(64)
  
  // Log Channels
  modLogChannelId       String? @db.VarChar(64)
  serverLogChannelId    String? @db.VarChar(64)
  voiceLogChannelId     String? @db.VarChar(64)
  joinLeaveLogChannelId String? @db.VarChar(64)
  commandLogChannelId   String? @db.VarChar(64)

  // Feature Toggles
  logMessages    Boolean @default(true)
  logMembers     Boolean @default(true)
  logVoice       Boolean @default(true)
  logModeration  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("log_configs")
}
