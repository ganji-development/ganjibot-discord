# =============================================================================
# GANJIBOT-DISCORD CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit your .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Discord Configuration
# -----------------------------------------------------------------------------
# Bot token from Discord Developer Portal
DISCORD_TOKEN=

# Application ID (Client ID) from Discord Developer Portal
DISCORD_CLIENT_ID=

# OAuth2 Client Secret from Discord Developer Portal
DISCORD_CLIENT_SECRET=

# Guild ID for development (optional, for faster command deployment)
DISCORD_DEV_GUILD_ID=

# -----------------------------------------------------------------------------
# Database Configuration (Prisma 7 adapter pattern)
# -----------------------------------------------------------------------------
# Database host
DATABASE_HOST=localhost

# Database port
DATABASE_PORT=3306

# Database user
DATABASE_USER=ganjibot

# Database password
DATABASE_PASSWORD=password

# Database name
DATABASE_NAME=ganjibot

# Connection pool size
DATABASE_CONNECTION_LIMIT=10

# -----------------------------------------------------------------------------
# API Configuration
# -----------------------------------------------------------------------------
# Port for the HTTP/GraphQL API server
API_PORT=3000

# Base URL for the API (used for OAuth redirects)
API_BASE_URL=http://localhost:3000

# JWT secret for session tokens (generate a strong random string)
JWT_SECRET=

# JWT token expiration (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Dashboard Configuration
# -----------------------------------------------------------------------------
# URL where the dashboard is hosted (for CORS and redirects)
DASHBOARD_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Pretty print logs in development (true/false)
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Google Cloud Platform (Production)
# -----------------------------------------------------------------------------
# GCP Project ID
GCP_PROJECT_ID=

# GCP Region for resources
GCP_REGION=us-central1

# Cloud SQL instance connection name (for production)
# Format: PROJECT_ID:REGION:INSTANCE_NAME
CLOUD_SQL_CONNECTION_NAME=

# -----------------------------------------------------------------------------
# Addon Configuration
# -----------------------------------------------------------------------------
# NPM registry URL for private addons (optional)
NPM_REGISTRY_URL=

# NPM auth token for private packages (optional)
NPM_AUTH_TOKEN=

# Directory for local addon development (optional)
LOCAL_ADDONS_DIR=./addons
